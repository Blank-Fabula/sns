{
  "manifest_version": 3,
  "name": "SNS 신규글 모아보기",
  "version": "0.19.7",
  "key": "",
  "description": "내가 직접 보는 유튜브·X·인스타그램 화면의 새 글을 내 브라우저 안에만 모아서 한 곳에서 보여줍니다.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "모아보기 열기"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "common.js",
        "youtube.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "common.js",
        "x.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "common.js",
        "instagram.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.vercel.app/*",
        "https://claude.ai/*",
        "https://*.claudeusercontent.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "https://i.ytimg.com/*",
    "https://yt3.ggpht.com/*",
    "https://yt3.googleusercontent.com/*",
    "https://pbs.twimg.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ]
}